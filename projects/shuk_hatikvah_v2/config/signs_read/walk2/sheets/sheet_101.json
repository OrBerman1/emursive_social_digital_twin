{"S01616": {"text": "ם ממנו את / נמה\"", "lang": "he", "legible": true, "kind": "other_text"}, "S01617": {"text": "1963 / חנות", "lang": "mixed", "legible": true, "kind": "other_text"}, "S01618": {"text": "שלומדים ממנ / את המותג \"נעמה\" / התבלינים", "lang": "he", "legible": true, "kind": "other_text"}, "S01619": {"text": "אין כניסה לחנות עם אופניים/קורקינט", "lang": "he", "legible": true, "kind": "other_text"}, "S01620": {"text": "לדיו, שלומדים ממנ / את המותג \"נעמה\" / לם התבלינים.", "lang": "he", "legible": true, "kind": "other_text"}, "S01621": {"text": "ALDERAAN", "lang": "en", "legible": true, "kind": "operator_shirt"}, "S01622": {"text": "לבדו", "lang": "he", "legible": true, "kind": "other_text"}, "S01623": {"text": "עם השנים, הוא הופך לאורים ותמים בתחומו, ושמו / הולך לפניו במומחה. / עובדיה מצרף את שלושת ילדיו, שלומדים ממנו את", "lang": "he", "legible": false, "kind": "other_text"}, "S01624": {"text": "חומו, ושמו", "lang": "he", "legible": true, "kind": "other_text"}, "S01625": {"text": "ALDERAAN", "lang": "en", "legible": true, "kind": "operator_shirt"}, "S01626": {"text": "על היהודים בחלקם, עד לשנת 1951 עת הברחת היהודים", "lang": "he", "legible": false, "kind": "other_text"}, "S01627": {"text": "הולך לפניו במומחה. / את ושלושת ילדיו שלומדים", "lang": "he", "legible": true, "kind": "other_text"}, "S01628": {"text": "", "lang": "he", "legible": false, "kind": "other_text"}, "S01629": {"text": "כניסה לחנות עם אופניים/קורקינט", "lang": "he", "legible": true, "kind": "other_text"}, "S01630": {"text": "מבצע \"עזרא ונחמיה\" (עליית יהודי עיראק)", "lang": "he", "legible": false, "kind": "other_text"}, "S01631": {"text": "יחי המלך / המשיח", "lang": "he", "legible": true, "kind": "banner"}}