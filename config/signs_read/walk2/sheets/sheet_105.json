"S01686": {"text": "שהם", "lang": "he", "legible": true, "kind": "other_text"},
"S01687": {"text": "נעמה", "lang": "he", "legible": true, "kind": "shop_sign"},
"S01688": {"text": "שהם אבודים\". משפחות / על היהודים בחלקם, עד לשנת 1951 / במבצע \"עזרא ונחמיה\".", "lang": "he", "legible": true, "kind": "other_text"},
"S01689": {"text": "הידע, והופכים את המותג \"נעמה\" / לשם דבר בעולם התבלינים.", "lang": "he", "legible": true, "kind": "other_text"},
"S01690": {"text": "אין כניסה לחנות עם / אופניים/קורקינט", "lang": "he", "legible": true, "kind": "other_text"},
"S01691": {"text": "המותג \"נעמה\" / התבלינים.", "lang": "he", "legible": true, "kind": "other_text"},
"S01692": {"text": "מבצע \"עזרא ונחמיה\" / פרעות פרהוד\" (החלו ב1941), אווירה של פחד ואימה שררה / בקרב הקהילות היהודיות, במיוחד בבגדאד ובבצרה.", "lang": "he", "legible": true, "kind": "other_text"},
"S01693": {"text": "ולומד לבדו", "lang": "he", "legible": true, "kind": "other_text"},
"S01694": {"text": "הבא", "lang": "he", "legible": true, "kind": "other_text"},
"S01695": {"text": "מבצע \"עזרא ונחמיה\" / 1963 / עובדיה נעמה", "lang": "he", "legible": true, "kind": "other_text"}}
