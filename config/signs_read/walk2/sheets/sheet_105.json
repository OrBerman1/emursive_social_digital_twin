{"S01680": {"text": "ובבצרה. / לילה הרגישו / ושמרו / היהודים", "lang": "he", "legible": true, "kind": "other_text"},
"S01681": {"text": "לבדו", "lang": "he", "legible": true, "kind": "other_text"},
"S01682": {"text": "המותג \"נעמ / התבלינים.", "lang": "he", "legible": true, "kind": "other_text"},
"S01683": {"text": "לשם דבר בעולם התבלינים.", "lang": "he", "legible": true, "kind": "other_text"},
