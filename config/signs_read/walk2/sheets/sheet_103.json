{"S01648": {"text": "בחלקם, עד לשנת 1951 עת הב / במבצע \"עזרא ונחמיה\".", "lang": "he", "legible": true, "kind": "other_text"},
"S01649": {"text": "", "lang": "none", "legible": false, "kind": "operator_shirt"},
"S01650": {"text": "לאורים ותמים בתחומו, ושמו", "lang": "he", "legible": true, "kind": "other_text"},
"S01651": {"text": "תבלינים.", "lang": "he", "legible": true, "kind": "other_text"},
"S01652": {"text": "", "lang": "none", "legible": false, "kind": "other_text"},
"S01653": {"text": "מבצע \"עזרא ונחמיה\" / 1951", "lang": "he", "legible": true, "kind": "other_text"},
"S01654": {"text": "ואימה / ובבצרה. / לילה", "lang": "he", "legible": true, "kind": "other_text"},
"S01655": {"text": "נעמה", "lang": "he", "legible": true, "kind": "shop_sign"},
"S01656": {"text": "", "lang": "none", "legible": false, "kind": "operator_shirt"},
"S01657": {"text": "(החלו ב1941), אווירה של פחד ואימה שררה / בקרב הקהילות היהודיות, במיוחד בבגדאד ובבצרה.", "lang": "he", "legible": true, "kind": "other_text"},
"S01658": {"text": "משפחות ערביות החביאו ושמרו / על היהודים בחלקם, עד לשנת 1951 עת הברחת היהודים", "lang": "he", "legible": true, "kind": "other_text"},
"S01659": {"text": "עובדיה מצרף את שלושת ילדיו, שלומדים ממנו את", "lang": "he", "legible": true, "kind": "other_text"},
"S01660": {"text": "יהודים שבניהם ובנותיהם נעצרו באישון לילה הרגיש", "lang": "he", "legible": true, "kind": "other_text"},
"S01661": {"text": "שהם אבודים\". משפחות ערביות החביאו ושמרו", "lang": "he", "legible": true, "kind": "other_text"},
"S01662": {"text": "פרעות פרהוד\" (החלו ב1941), אווירה של פחד ואימה שררה", "lang": "he", "legible": true, "kind": "other_text"},
"S01663": {"text": "לייצר תבלינים.", "lang": "he", "legible": true, "kind": "other_text"}}
