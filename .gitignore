# Data, caches and weights are NOT in git: the raw data is downloaded separately (README.md section 2),
# setup.bat creates the folder structure and downloads the model weights.
data/
models/
# projects made on the projects page: their data and uploaded anchor files stay local; project.json is small
projects/*/data/
projects/*/config/anchor_files/
projects/*/*.log
*.insv
*.zip
*.pt

# Python environments (rebuilt by setup.bat)
.venv/
.venv-imu/
__pycache__/
*.pyc

# macOS Finder metadata
.DS_Store
